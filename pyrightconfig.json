{
  "include": ["persona_review", "tests"],
  "pythonVersion": "3.13",
  "typeCheckingMode": "strict",

  // Strict from the first commit, with no baseline and no rule suppressions.
  //
  // There was briefly a block here turning off four `reportUnknown*` rules, on the grounds
  // that everything in this program originates in `json.load` of a schema it does not own.
  // The honest fix was to type that boundary instead: `validate.JSONValue` names what parsed
  // JSON is, a single `cast` converts at the parse site, and narrowing by `isinstance` — which
  // the gate does anyway, because it cannot trust the shape — carries the type the rest of the
  // way. No TypedDict, so nothing here asserts a schema shape the plugin is free to change.
  //
  // `include` must name persona_review/ explicitly. An earlier config named a directory that
  // held shell scripts, so exactly one file was analysed and a clean strict run covered none
  // of the code that ships. The `types` flake check now ends with a negative control that
  // fails if the checker accepts `return x + None` in the library.
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
