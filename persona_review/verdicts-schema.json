{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Validator Verdicts",
 "type": "object",
 "required": ["verdicts"],
 "properties": {
  "verdicts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["#", "validated", "reason"],
    "properties": {
     "#": {"type": "integer", "minimum": 1},
     "validated": {"type": "boolean"},
     "reason": {"type": "string", "minLength": 1}
    }
   }
  }
 }
}
