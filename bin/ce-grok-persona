#!/usr/bin/env bash
# ce-grok-persona — run a compound-engineering review persona as a Grok Build (xAI grok-4.6) agent.
#
# Sibling of ce-codex-persona: same persona definitions, same findings schema, but a third
# independent model family. Where cross-model agreement is the signal, a family that shares neither
# pretraining run nor post-training lineage with Claude or GPT is worth more than another pass from
# either. Read-only sandbox: the agent inspects the repo (git diff/grep/read) but never mutates it.
#
# The persona brief and findings schema come from the installed compound-engineering plugin
# (skills/ce-code-review/references/) — the SAME assets CE's own cross-model peer feeds its provider.
# That is what makes a run here comparable to a CE peer result rather than an approximation of one.
# CE pins one editorial model+tier per provider and exposes no knob for either; this wrapper is where
# an arbitrary model × effort combination can be run, which is its remaining reason to exist.
#
# Output contract, built for a CALLING AGENT rather than a terminal: stdout is one summary line
# naming the finding counts by severity and the artifact path. The event stream and the validated
# findings JSON are written to a run directory ($CE_PERSONA_RUN_DIR, else a mktemp dir) so a caller
# reads detail only when it has a reason to. The exit status is the verdict — non-zero when the
# runner failed or the answer was not schema-valid findings.
#
# grok is asked for schema-constrained output AND a streaming NDJSON envelope at once, so the
# findings arrive already parsed in the terminal `result` event while the stream still grows byte
# by byte for liveness. No transcript scanning: that heuristic caused two silent false-passes.
#
# Usage:
#   ce-grok-persona <persona> [-C <repo-dir>] [-b <base-ref>] [-m <model>] [-e <effort>] [-c <file>]
#
#   <persona>        e.g. adversarial-reviewer, correctness-reviewer, security-reviewer — any file in
#                    the plugin's references/personas/. A leading `ce-` and a `.md` suffix are both
#                    accepted; an unknown name lists what is installed.
#   -C, --cd         repo to review in (default: cwd)
#   -b, --base       base ref; the persona is told to `git diff <base>..HEAD` (default: none → the
#                    agent reviews whatever scope it judges from the repo state)
#   -m, --model      grok model (default: grok-4.6)
#   -e, --effort     reasoning effort: low|medium|high|xhigh (default: xhigh, the top tier — the
#                    TUI labels it "Deep / Maximum reasoning"). Do not pass `max`: grok's
#                    ReasoningEffort enum carries it and clap parses it, but 1.0.3 and 1.0.4 both
#                    reject it during validation. The value goes through verbatim, so a build whose
#                    accepted set catches up with the enum needs no change here.
#   -c, --context    file whose contents are appended as extra review context (- for stdin)
#
# Env:
#   CE_REVIEW_ASSETS  override the plugin's references/ directory (must hold personas/ and
#                     findings-schema.json). Otherwise the highest installed plugin version wins.
#
# Pairs with the Claude-side ce-code-review pipeline and with ce-codex-persona: run the high-stakes
# personas (correctness, adversarial, security) through all three and merge/dedup the findings.
set -euo pipefail

# bash >= 4.4, enforced rather than worked around. Expanding an EMPTY array as
# "${ARR[@]}" is an unbound-variable error under `set -u` before 4.4, and with an EXIT
# trap installed that abort exits **0** — a wrapper that never called the model reporting
# success, which is the one failure class this tool exists to prevent. Individual call
# sites can be written defensively; the exit-0 masking applies to every future `set -u`
# slip, so the version is the thing to check. macOS ships 3.2; the Nix package patches
# the shebang to a modern bash, so this only fires for a source checkout.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
	{ [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]:-0}" -lt 4 ]; }; then
	echo "ce-grok-persona: needs bash >= 4.4, found ${BASH_VERSION:-unknown}." >&2
	echo "  macOS ships bash 3.2, where an unset-variable abort inside this script would exit 0." >&2
	echo "  Install a newer bash (nix profile install nixpkgs#bash) or use the Nix package." >&2
	exit 1
fi

usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

# Split, because the one-liner this replaced could never reach its own `exit 2`: the
# inner test only ran once the outer had established PERSONA was empty, -h, or --help.
# Missing the required argument printed 46 lines to stdout and exited 0 — success, and a
# transcript's worth of it, for an invocation that reviewed nothing.
PERSONA="${1:-}"
case "$PERSONA" in
	-h|--help) usage; exit 0 ;;
	"") usage >&2; exit 2 ;;
esac
shift

MODEL="grok-4.6"; REPO="$PWD"; BASE=""; CTX=""; EFFORT="xhigh"
while [ $# -gt 0 ]; do
	case "$1" in
		-C|--cd) REPO="$2"; shift 2 ;;
		-m|--model) MODEL="$2"; shift 2 ;;
		-e|--effort) EFFORT="$2"; shift 2 ;;
		-b|--base) BASE="$2"; shift 2 ;;
		-c|--context) CTX="$2"; shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "ce-grok-persona: unknown arg '$1'" >&2; usage; exit 2 ;;
	esac
done

command -v grok >/dev/null 2>&1 || { echo "ce-grok-persona: grok not on PATH (see https://github.com/xai-org/grok-build)" >&2; exit 1; }

[ -d "$REPO" ] || { echo "ce-grok-persona: -C '$REPO' is not a directory" >&2; exit 2; }
# A base ref that does not resolve is not a smaller review, it is an unscoped one: the
# prompt would still tell the agent to `git diff $BASE..HEAD`, that command would fail
# inside the sandbox, and the agent would review whatever it judged instead — returning
# findings, or none, for a scope nobody chose. Refuse before spending the run.
if [ -n "$BASE" ]; then
	git -C "$REPO" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null || {
		echo "ce-grok-persona: base ref '$BASE' does not resolve in $REPO" >&2
		exit 2
	}
fi

# Preflight everything the run needs, including the findings gate — checking the gate
# after the model call would spend a full xhigh run to discover a missing import.
#
# The gate is a package module, not a sibling script: `persona_review` must be importable.
# $PERSONA_REVIEW_PYTHONPATH names its root, which the packaged build sets; a source
# checkout falls back to the directory above this wrapper. Never a PATH lookup for the
# module itself — a PATH dependency is what killed the previous version of this wrapper.
command -v python3 >/dev/null 2>&1 || { echo "ce-grok-persona: python3 not on PATH (needed by the findings gate)" >&2; exit 1; }
PYROOT="${PERSONA_REVIEW_PYTHONPATH:-$(cd "$(dirname "$0")/.." && pwd)}"
# The CWD, not $PYROOT, is what `python3 -c` and `python3 -m` put FIRST on sys.path, ahead
# of every PYTHONPATH entry. So a `persona_review/` directory in the current directory —
# and $REPO defaults to the cwd, i.e. the repo under review — silently REPLACED this gate:
# the run reported a clean review of a run that never happened, and the planted module
# executed as the user at import time, before grok was invoked and outside the read-only
# sandbox the rest of this script is careful to set. PYTHONSAFEPATH drops that implicit
# entry (3.11+; `python3 -P` is the flag form). Exported before the preflight import
# below, which has exactly the same hole.
export PYTHONSAFEPATH=1
PYTHONPATH="$PYROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -c 'import persona_review.validate' 2>/dev/null || {
	echo "ce-grok-persona: cannot import persona_review.validate from $PYROOT" >&2
	echo "  Set PERSONA_REVIEW_PYTHONPATH to the directory containing persona_review/." >&2
	exit 1
}
export PYTHONPATH="$PYROOT${PYTHONPATH:+:$PYTHONPATH}"

# Personas AND the findings schema come from one place — the plugin's ce-code-review
# references/ directory — so the brief and the shape it is asked to return can never come from
# different installs. Reading them straight off disk is also what drops the ce-lite trap: the
# plugin cache reaches PATH only through the interactive shell env, so a resolver binary looked
# up on PATH left every non-interactive caller (an agent's `bash -c`, a background job, launchd)
# seeing "not on PATH" for something plainly installed.
resolve_ce_assets() {
	if [ -n "${CE_REVIEW_ASSETS:-}" ]; then printf '%s\n' "$CE_REVIEW_ASSETS"; return 0; fi
	local -a dirs=( "$HOME"/.claude/plugins/cache/compound-engineering-plugin/compound-engineering/*/skills/ce-code-review/references )
	# Version-sort, not glob order: bash sorts lexically, which puts 3.9 after 3.13.
	printf '%s\n' "${dirs[@]}" | sort -V | tail -1
}

ASSETS="$(resolve_ce_assets)"
[ -d "$ASSETS/personas" ] || {
	echo "ce-grok-persona: no compound-engineering personas under $ASSETS" >&2
	echo "  Install the plugin (claude plugin install compound-engineering@compound-engineering-plugin)" >&2
	echo "  or point CE_REVIEW_ASSETS at a references/ directory holding personas/." >&2
	exit 1
}

# Not every brief in that directory can do this job. Three of the sixteen
# (agent-native-reviewer, deployment-verification-agent, learnings-researcher) specify a MARKDOWN
# output format and carry no findings contract, so asking one for findings JSON produces a run
# that ends in "no findings JSON object" — indistinguishable from a model that gave up. Offer only
# the briefs that carry the contract, and say why when one is asked for by name.
persona_emits_findings() { grep -qi 'findings.schema\|findings schema' "$1"; }

list_personas() {
	for f in "$ASSETS"/personas/*.md; do
		[ -f "$f" ] && persona_emits_findings "$f" && printf '  %s\n' "$(basename "$f" .md)"
	done
	# Explicit: the loop's last test decides the function's status otherwise, so an
	# assets dir with no capable persona would abort the caller under `set -e` before
	# it could exit with its own code.
	return 0
}

# Accept `ce-adversarial-reviewer`, `adversarial-reviewer`, or `adversarial-reviewer.md`.
PERSONA="${PERSONA#ce-}"; PERSONA="${PERSONA%.md}"
# A bare brief name, never a path. The name is interpolated into every artifact path, so
# `../outside` resolved a findings-capable brief from outside personas/ AND put the run's
# artifacts outside $RUN_DIR — where the clear-stale-artifacts `rm -f` above would then
# delete files that were never ours to touch.
case "$PERSONA" in
	*/* | "" | .*)
		echo "ce-grok-persona: persona '$PERSONA' must be a bare brief name, not a path" >&2
		exit 2
		;;
esac
PERSONA_FILE="$ASSETS/personas/$PERSONA.md"
[ -f "$PERSONA_FILE" ] || {
	echo "ce-grok-persona: unknown persona '$PERSONA'. Personas that return findings JSON:" >&2
	list_personas >&2
	exit 1
}
persona_emits_findings "$PERSONA_FILE" || {
	echo "ce-grok-persona: persona '$PERSONA' specifies a markdown output format and carries no" >&2
	echo "  findings contract, so it cannot satisfy this wrapper. Personas that can:" >&2
	list_personas >&2
	exit 2
}
SCHEMA_FILE="$ASSETS/findings-schema.json"
[ -f "$SCHEMA_FILE" ] || { echo "ce-grok-persona: missing findings schema at $SCHEMA_FILE" >&2; exit 1; }

build_prompt() {
	cat "$PERSONA_FILE"
	printf '\n\n---\n\n'
	printf 'This is an authorized review of the maintainer'\''s own repository.\n'
	printf 'You are reviewing a code change in the working-directory git repo, as the persona above.\n'
	# shellcheck disable=SC2016  # the backticks are markdown for the model, not a command substitution
	[ -n "$BASE" ] && printf 'Run `git diff %s..HEAD` yourself to get the full diff, and review the WHOLE change.\n' "$BASE"
	if [ -n "$CTX" ]; then
		printf '\nAdditional review context:\n'
		if [ "$CTX" = "-" ]; then cat; else cat "$CTX"; fi
	fi
	printf '\nReturn your findings as a single JSON object at the END of your reply (after any analysis),\n'
	printf 'with "reviewer" set to "%s" and matching this schema:\n\n' "$PERSONA"
	cat "$SCHEMA_FILE"
	printf '\n'
	# 14 of the 16 briefs say "Use the anchored confidence rubric in the subagent template" — a file
	# CE injects at dispatch and this wrapper does not. Sending the brief without it left the
	# reviewer grading against a rubric it never saw, and the homemade gloss that stood in for it
	# ("25=weak") inverted CE's meaning, where 0 and 25 mean SUPPRESS. Ship the real thing.
	rubric
	printf '\nAn empty findings array is a valid answer. Still populate residual_risks and\n'
	printf 'testing_gaps when they apply.\n'
}

# The schema-conformance constraints, confidence anchors and quote-the-line gate, taken verbatim
# from the template the personas reference. Falls back to a summary if CE restructures the file —
# a missing rubric must not silently become no rubric.
rubric() {
	local template="$ASSETS/subagent-template.md" block=""
	[ -f "$template" ] && block="$(sed -n '/^\*\*Schema conformance/,/^Example of a schema-valid finding/p' "$template" | sed '$d')"
	if [ -n "$block" ]; then
		printf '%s\n' "$block"
	else
		printf 'Confidence anchors are behavioral: 100=verifiable from the code itself, 75=you\n'
		printf 'double-checked and named a concrete observable consequence, 50=real but a nitpick.\n'
		printf 'Anchors 0 and 25 mean SUPPRESS — do not emit them. A finding at 75 or 100 MUST\n'
		printf 'quote the verbatim motivating line with file:line as its first evidence item.\n'
	fi
}

# grok takes the prompt from a file, not stdin, and re-parses a *.json prompt file as ACP content
# blocks — so the suffix here is load-bearing. No `exec` below: that would replace the shell and
# the EXIT trap would never fire.
PROMPT_FILE="$(mktemp "${TMPDIR:-/tmp}/ce-grok-persona.XXXXXX")"
ERR_FILE="$(mktemp "${TMPDIR:-/tmp}/ce-grok-persona-err.XXXXXX")"
trap 'rm -f "$PROMPT_FILE" "$ERR_FILE"' EXIT
build_prompt >"$PROMPT_FILE"

# Size preflight, fail-fast. The idea is lifted from nyldn/claude-octopus's
# enforce_context_budget, but deliberately only its `fail` branch: its default strategy
# SUMMARIZES an oversized prompt before dispatch, and a review of a summarized diff produces
# findings nobody can check against the code. Better to refuse and let the caller narrow the
# scope. Exit 78 (EX_CONFIG) so a caller can tell "too big" from "review failed".
preflight_size() {
	local bytes budget_tokens tokens diff_bytes=0
	bytes=$(wc -c <"$PROMPT_FILE")
	# Count the DIFF, not just the prompt. The prompt does not contain the change — it
	# tells the agent to fetch it — so weighing the prompt alone measured a near-constant
	# ~1.2KB: `-b HEAD~2000` and `-b HEAD~1` produced the same number, the budget could
	# never fire, and the advice to "narrow with -b" could not have helped. The diff is
	# the input that actually overruns a context, and it is the one that was unmeasured.
	if [ -n "$BASE" ]; then
		diff_bytes=$(git -C "$REPO" diff "$BASE"..HEAD | wc -c | tr -d '[:space:]')
	fi
	budget_tokens="${CE_PERSONA_MAX_PROMPT_TOKENS:-80000}"
	# ~4 chars/token is the same rough conversion CE's own large-diff preflight uses; this
	# only has to be right enough to catch an order-of-magnitude overrun.
	tokens=$(( (bytes + diff_bytes) / 4 ))
	[ "$tokens" -le "$budget_tokens" ] || {
		echo "ce-grok-persona: review is ~${tokens} tokens (${bytes} prompt + ${diff_bytes} diff bytes), over the ${budget_tokens}-token budget." >&2
		echo "  Narrow the review (-b a nearer base, or a smaller -c context) rather than sending it." >&2
		echo "  Raise CE_PERSONA_MAX_PROMPT_TOKENS only if the provider can genuinely take it." >&2
		exit 78
	}
}
preflight_size

# Artifacts the caller may want after the run outlive it, in a run dir it can point at.
# The event stream is kept for debugging and for judging how an arm reasoned; the findings
# JSON is the machine handoff. Neither lands in the caller's context unless it asks.
RUN_DIR="${CE_PERSONA_RUN_DIR:-$(mktemp -d "${TMPDIR:-/tmp}/ce-persona-run.XXXXXX")}"
mkdir -p "$RUN_DIR"
EVENTS_FILE="$RUN_DIR/$PERSONA-grok-events.jsonl"
FINDINGS_FILE="$RUN_DIR/$PERSONA-grok.json"
PROV_FILE="$RUN_DIR/$PERSONA-grok-provenance.json"

# Clear last run's artifacts before this one starts. The paths are deterministic and
# $CE_PERSONA_RUN_DIR is a caller-supplied directory meant to be reused, so a failed run
# used to leave the PREVIOUS run's findings and provenance sitting next to this run's
# fresh event stream — and the sidecar whose whole job is attesting which brief produced
# these findings attested the wrong run. A failed run must leave no artifact at all.
rm -f "$FINDINGS_FILE" "$PROV_FILE"

# Which brief and which schema this run actually used, by content hash. Two arms are only
# comparable if they ran the same brief, and the briefs live in a plugin cache that updates
# underneath us — 13-of-16 was 10-of-16 a week ago. Without this, drift between runs is invisible
# and a comparison silently stops meaning anything. A sidecar, so the findings artifact stays
# exactly the shape CE's fold-in expects.
#
# The validator writes it, not this shell: interpolating paths into a JSON heredoc breaks the
# moment one contains a quote or a backslash, and JSON is structured data.
PROV_ARGS=(
	--provenance-out "$PROV_FILE"
	--prov "provider=grok"
	--prov "model=$MODEL"
	--prov "effort=$EFFORT"
	--prov "persona=$PERSONA"
	--prov "assets_dir=$ASSETS"
	--prov "base_ref=$BASE"
	--prov "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	--prov-file "persona=$PERSONA_FILE"
	--prov-file "schema=$SCHEMA_FILE"
)

# --sandbox read-only is the real boundary; bypassPermissions only suppresses the approval prompt,
# which headless has no way to answer. --verbatim keeps grok from offloading a large prompt to a
# session file.
#
# --json-schema DOES compose with --output-format streaming-messages-json, contradicting grok's
# own help text ("--json-schema ... Implies --output-format json") and CE's comment that a schema
# forces non-streaming output. Verified against grok 1.0.4: the terminal `result` event carries
# `structured_output` as a parsed object next to is_error and stop_reason. So the answer arrives
# already extracted -- no scanning a prose transcript for the model's own object -- AND the stream
# still grows byte by byte, which is what any idle-watchdog needs.
#
# The event stream goes to a file, never to stdout: a calling agent should pay one summary line,
# not ten thousand tokens of reasoning it has to re-parse.
STATUS=0
grok --prompt-file "$PROMPT_FILE" \
	--verbatim \
	--model "$MODEL" \
	--effort "$EFFORT" \
	--cwd "$REPO" \
	--sandbox read-only \
	--permission-mode bypassPermissions \
	--disable-web-search \
	--json-schema "$(cat "$SCHEMA_FILE")" \
	--output-format streaming-messages-json >"$EVENTS_FILE" 2>"$ERR_FILE" || STATUS=$?
[ "$STATUS" -eq 0 ] || {
	echo "ce-grok-persona: grok exited $STATUS" >&2
	tail -5 "$ERR_FILE" >&2
	exit "$STATUS"
}

# A run that returns prose but no schema-shaped findings, or a well-formed object with the required
# fields missing, is a failed review that otherwise reads as a clean one. Fail loudly instead.
# Keep this the last command: its exit status is the wrapper's, and its one stdout line plus the
# artifact path is the whole contract a calling agent has to read.
python3 -m persona_review.validate --mode grok-events --findings-out "$FINDINGS_FILE" "${PROV_ARGS[@]}" "$EVENTS_FILE" "$SCHEMA_FILE"
